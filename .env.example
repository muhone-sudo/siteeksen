# docker compose için ortam değişkenleri — ŞABLON.
#
# Kullanım:  cp .env.example .env   → değerleri doldurun → docker compose up -d --build
#
# Zorunlu değerlerden biri boşsa compose AÇILMAZ (bilerek): varsayılan bir
# parolayla sessizce ayağa kalkmak, üretimde bilinen parolayla çalışmak demekti.
# Bu dosyaya GERÇEK DEĞER YAZMAYIN; .env depoya girmez (.gitignore).
#
# Üretmek için:  openssl rand -base64 32

# ---------------------------------------------------------------- veritabanı
# Şema sahibi (yalnızca migrate kabı kullanır)
DB_PASSWORD=
# Servis rolleri — parolalarını migrate kabı atar (cmd/migrate).
#   siteeksen_app      : kimlik dışındaki bütün servisler (RLS geçerli)
#   siteeksen_identity : yalnızca identity-service (site verisine erişemez)
APP_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
# Bilinen parolalı demo hesaplar (5551234567 / Demo123!). Üretimde false.
SEED_DEMO_DATA=false

# ---------------------------------------------------------------- kimlik
# En az 32 karakter. Boşsa gateway ve servisler istekleri REDDEDER (fail-closed).
JWT_SECRET=
# Admin paneli oturum anahtarı
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001
# Tarayıcının erişeceği gateway adresi (admin paneli DERLENİRKEN gömülür)
PUBLIC_API_URL=http://localhost:8888/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------- kişisel veri
# TCKN / IBAN ve sakin acil bilgi kartı (özel nitelikli veri) şifreleme anahtarı: 32 bayt, base64.
# Yoksa personel servisi AÇILMAZ; community servisinde acil bilgi kartı uçları 503 döner.
# Anahtar kaybolursa şifreli veri GERİ ALINAMAZ — yedeğini gizli kasada tutun.
PII_ENCRYPTION_KEY=
# Birincil anahtarın kimliği (şifreli metne yazılır; küçük harf/rakam, en çok 16).
# Anahtar döndürürken YENİ anahtara yeni kimlik verin (k1 → k2); aynı kimliği
# farklı anahtarla kullanmak eski kayıtları okunamaz kılar.
PII_ENCRYPTION_KEY_ID=k1
# Yalnızca ÇÖZMEK için eski anahtarlar: "k1:<base64>,k0:<base64>". Döndürme
# bitip `cmd/rotate-pii` "eski anahtarla kayıt kalmadı" dedikten sonra boşaltın.
# Yordam: docs/runbook-anahtar-dondurme.md
PII_ENCRYPTION_PREVIOUS_KEYS=

# ---------------------------------------------------------------- dosya depolama
# local : kap içindeki /data/files (compose birimi document_files)
# s3    : S3 uyumlu (Oracle Object Storage, Cloudflare R2, AWS S3)
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# ---------------------------------------------------------------- zamanlayıcı
# Gecikmiş aidat, sözleşme ihbarı ve açık kalan devriye taraması (cmd/scheduler).
# En az 1m. Aynı bildirim iki kez üretilmez; aralığı kısaltmak tekrar göndermez.
SCHEDULER_INTERVAL=15m

# ---------------------------------------------------------------- mobil
# Mobil uygulamalar derlenirken verilir:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8888/api/v1

# ---------------------------------------------------------------- Kubernetes
# Kümede aynı değerler gizli nesne olarak verilir (bkz. k8s/deployments.yaml başı):
#   db-admin, db-app, db-identity, app-secrets, storage
#
# ENTEGRE OLMAYANLAR (değişken tanımlamak bir şeyi açmaz):
#   Ödeme sağlayıcısı (iyzico), Firebase push, SMS/e-posta sağlayıcıları ve
#   YZ servisleri kodda BAĞLI DEĞİLDİR. Bu yüzden değişkenleri burada yok.

# ---------------------------------------------------------------- saat dilimi
# İş günü (vade, gecikme günü, görev başlangıcı) bu saat dilimine göre hesaplanır;
# servisler hem Go sürecini hem veritabanı oturumlarını buna sabitler. Boşsa Europe/Istanbul.
# APP_TIMEZONE=Europe/Istanbul

# --- Dış bildirim sağlayıcıları (isteğe bağlı) ---
# Boş bırakılırsa SMS/e-posta bildirimleri kuyrukta PENDING kalır; uygulama içi bildirim çalışır.
# Netgsm (SMS): kullanıcı kodu, API alt kullanıcı şifresi ve onaylı gönderici başlığı.
# Sistem yalnızca işlemsel ileti gönderir (etkinleştirme kodu, acil duyuru); ticari ileti İYS ister.
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
# SMTP (e-posta): SMTP_TLS = starttls (587) | tls (465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls

# --- Kartla ödeme: iyzico ödeme formu (isteğe bağlı) ---
# Dördü birlikte verilmeli (yarım yapılandırmada finans servisi açılmaz); hiçbiri yoksa kartla ödeme
# "sağlayıcı bağlı değil" yanıtı döner. Deneme: https://sandbox-api.iyzipay.com · Canlı: https://api.iyzipay.com
# IYZICO_CALLBACK_URL, gateway'in herkese açık adresi olmalı: https://<alan-adı>/api/v1/public/payments/iyzico/callback
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
IYZICO_CALLBACK_URL=
# Ödemeden sonra tarayıcının yönlendirileceği sonuç sayfası (panel: https://<panel>/odeme-sonuc)
PAYMENT_RESULT_URL=
# Borcu yoktur belgesi karekodunun doğrulama adresi (panel: https://<panel>/dogrula)
PUBLIC_VERIFY_BASE_URL=
