#!/usr/bin/env bash
# Ana makinede PostgreSQL istemcisi yok; aynı sürüm istemci Docker'dan çalıştırılır.
# Docker Desktop /tmp'yi paylaşmadığı için dosya argümanları stdin/stdout'a çevrilir.
tool="$1"; shift
args=(); infile=""; outfile=""; skip=0
for ((i=1;i<=$#;i++)); do
  a="${!i}"
  if [ $skip = 1 ]; then skip=0; continue; fi
  case "$a" in
    127.0.0.1|localhost) a=host.docker.internal ;;
  esac
  a="${a//@127.0.0.1:/@host.docker.internal:}"; a="${a//@localhost:/@host.docker.internal:}"
  if [ "$tool" = psql ] && [ "$a" = "-f" ]; then j=$((i+1)); infile="${!j}"; args+=("-f" "-"); skip=1; continue; fi
  if [ "$tool" = pg_dump ] && [[ "$a" == --file=* ]]; then outfile="${a#--file=}"; continue; fi
  if [ "$tool" = pg_restore ] && [ -f "$a" ]; then infile="$a"; continue; fi
  args+=("$a")
done
# Her çağrıda yeni kap açmak yavaş (test jetonunun 15 dk ömrünü aşıyor); tek istemci kabı açık tutulur.
if [ "$(docker inspect -f '{{.State.Running}}' pgclient 2>/dev/null)" != "true" ]; then
  docker rm -f pgclient >/dev/null 2>&1
  docker run -d --name pgclient --add-host=host.docker.internal:host-gateway postgres:16-alpine sleep infinity >/dev/null
fi
run=(docker exec -i -e PGPASSWORD -e PGHOST -e PGPORT -e PGUSER -e PGDATABASE pgclient "$tool" "${args[@]}")
if [ -n "$infile" ] && [ -n "$outfile" ]; then "${run[@]}" <"$infile" >"$outfile"
elif [ -n "$infile" ]; then "${run[@]}" <"$infile"
elif [ -n "$outfile" ]; then "${run[@]}" >"$outfile"
else "${run[@]}"; fi
